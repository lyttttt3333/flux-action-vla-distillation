{
  "source_root": "outputs/droid/source",
  "index_dir": "outputs/droid/index",
  "output_dir": "outputs/droid/late-video-prune-k8-distill-seed42",
  "init_policy": "outputs/droid/variants/sd",
  "teacher_policy": "outputs/droid/variants/sd",
  "teacher_distill_weight": 50.0,
